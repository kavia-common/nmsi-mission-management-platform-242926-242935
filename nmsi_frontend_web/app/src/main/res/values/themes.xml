<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NMSI" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorPrimaryVariant">@color/ocean_primary</item>
        <item name="colorOnPrimary">@color/ocean_on_primary</item>

        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorSecondaryVariant">@color/ocean_secondary</item>
        <item name="colorOnSecondary">@color/ocean_on_secondary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/ocean_background</item>
        <item name="android:windowBackground">@color/ocean_background</item>
        <item name="colorSurface">@color/ocean_surface</item>
        <item name="colorOnSurface">@color/ocean_text</item>

        <item name="colorError">@color/ocean_error</item>

        <!-- Typography defaults for legacy widgets -->
        <item name="android:textColorPrimary">@color/ocean_text</item>
        <item name="android:textColorSecondary">@color/ocean_text_muted</item>

        <!-- System bars -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/ocean_background</item>

        <!-- Global component styling hooks -->
        <item name="materialCardViewStyle">@style/Widget.NMSI.Card</item>
        <item name="toolbarStyle">@style/Widget.NMSI.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.NMSI.Button</item>
        <item name="textInputStyle">@style/Widget.NMSI.TextInputLayout</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.NMSI.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/ocean_surface</item>
        <item name="titleTextColor">@color/ocean_text</item>
        <item name="subtitleTextColor">@color/ocean_text_muted</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Cards: rounded, subtle stroke, moderate elevation -->
    <style name="Widget.NMSI.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/ocean_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Buttons: keep filled buttons as primary, text buttons for nav -->
    <style name="Widget.NMSI.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Text inputs -->
    <style name="Widget.NMSI.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/ocean_surface</item>
        <item name="boxStrokeColor">@color/ocean_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/ocean_text_muted</item>
    </style>

</resources>
