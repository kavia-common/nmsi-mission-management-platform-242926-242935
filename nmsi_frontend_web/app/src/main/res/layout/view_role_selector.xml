<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roleSelector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/roleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Role"
        android:textColor="@color/ocean_text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/roleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/roleAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/role_admin" />

        <RadioButton
            android:id="@+id/roleStaff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/role_staff" />

        <RadioButton
            android:id="@+id/roleVolunteer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:checked="true"
            android:text="@string/role_volunteer" />
    </RadioGroup>

    <TextView
        android:id="@+id/roleHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/role_help"
        android:textColor="@color/ocean_text_muted"
        android:textSize="12sp" />

</LinearLayout>
