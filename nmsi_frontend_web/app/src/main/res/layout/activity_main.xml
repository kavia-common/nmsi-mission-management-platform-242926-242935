<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ocean_surface"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_name"
        app:titleTextColor="@color/ocean_text" />

    <!-- Subtle divider under app bar (more "SaaS dashboard" than heavy elevation). -->
    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/ocean_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Main content area: sidebar + fragment content -->
    <LinearLayout
        android:id="@+id/mainRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider">

        <!-- Sidebar -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="288dp"
            android:layout_height="match_parent"
            android:background="@color/ocean_surface"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/sidebarHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="Workspace"
                android:textColor="@color/ocean_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navOverview"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/nav_overview" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navDonations"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/nav_donations" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navVolunteers"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/nav_volunteers" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navProjects"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/nav_projects" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navDonorCrm"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/nav_donor_crm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navReports"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/nav_reports" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navSettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/nav_settings" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/ocean_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuth"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/ocean_primary"
                android:text="@string/auth_sign_in"
                android:textColor="@color/ocean_on_primary" />
        </LinearLayout>

        <!-- Content container: uses consistent padding and tinted background for depth -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ocean_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
